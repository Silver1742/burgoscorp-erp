{
  "name": "burgoscorp-erp-api",
  "version": "0.1.0",
  "description": "API REST del ERP de BurgosCorp",
  "main": "src/server.js",
  "scripts": {
    "prestart": "node scripts/restablecer-admin.js && node scripts/usuarios-prueba.js",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node scripts/seed.js",
    "usuarios:prueba": "node scripts/usuarios-prueba.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "db:init": "node scripts/init-db.js"
  },
  "type": "module",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
