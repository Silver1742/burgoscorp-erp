# Copiar a .env y completar. El archivo .env nunca se sube al repositorio.

# Servidor
NODE_ENV=development
PORT=3000
# 127.0.0.1 en desarrollo. Para probar desde el celular en la misma red usar la IP de la PC
# (ej. 192.168.0.10); en la nube, 0.0.0.0 detrás del proxy del proveedor.
HOST=127.0.0.1
# Cantidad de proxies delante de la API (Render / Railway = 1). 0 en desarrollo.
# En producción es obligatorio (si de verdad no hay proxy, definir SIN_PROXY=true).
TRUST_PROXY=0
# Orígenes web permitidos por CORS, separados por coma (la app nativa no los necesita)
CORS_ORIGINS=

# Base de datos MySQL / MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=burgoscorp_app
DB_PASSWORD=
DB_NAME=burgoscorp_erp
# true si el proveedor en la nube exige conexión cifrada
DB_SSL=false

# JWT: dos secretos DISTINTOS de 32+ caracteres. Generarlos con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_TEMP_SECRET=
# En minutos, entre 1m y 60m
JWT_ACCESS_EXPIRES=15m
# Días de cada refresh token (máx. 30). La sesión dura como mucho 30 días desde el login.
REFRESH_TOKEN_DAYS=7
# Clave para el HMAC de los códigos por email y de respaldo (32+ caracteres, distinta de las de JWT)
CODIGOS_HMAC_KEY=

# Registro libre de cuentas. Si no se define: abierto en desarrollo y cerrado en producción
# (ahí las cuentas las crea RRHH o un administrador). Las cuentas sin legajo no ven ningún módulo.
REGISTRO_ABIERTO=

# Zona horaria de la empresa (fechas de "hoy", vencimientos y fichaje)
TZ_EMPRESA=America/Argentina/Buenos_Aires

# Clave para cifrar los secretos 2FA: 32 bytes en base64 (o 64 caracteres hexadecimales). Generarla con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Si se cambia, los usuarios con 2FA tienen que volver a configurarlo.
TOTP_ENC_KEY=
APP_NOMBRE=BurgosCorp ERP

# Correo saliente (códigos de verificación, recuperación y 2FA por email).
# Sin SMTP_HOST, en desarrollo los correos se muestran en la consola de la API.
# Ejemplo con Gmail: smtp.gmail.com, puerto 587, y una "contraseña de aplicación" de Google.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=BurgosCorp ERP <no-responder@burgoscorp.test>

# Carpeta de fotos y archivos subidos (relativa a backend/ o absoluta)
UPLOADS_DIR=uploads

# Login social: ver docs/guia-oauth.md. Vacío = botón deshabilitado.
GOOGLE_CLIENT_IDS=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
OAUTH_REDIRECT_URIS=burgoscorp://oauth

# Contraseña de las cuentas de prueba que crea `npm run seed`. Opcional en desarrollo;
# obligatoria (12+ caracteres) si se corre el seed en producción.
SEED_PASSWORD=
