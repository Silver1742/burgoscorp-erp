# Copiar a mobile/.env. Todo lo que empieza con EXPO_PUBLIC_ queda DENTRO de la app
# y cualquiera puede leerlo: solo URLs e ids públicos, nunca secretos.

# URL de la API (con /api/v1 al final).
#  - Navegador en la misma PC:  http://localhost:3000/api/v1
#  - Celular con Expo Go en la misma red WiFi: la IP de la PC, ej. http://192.168.0.10:3000/api/v1
#    (y en backend/.env poner HOST=0.0.0.0 o esa IP)
#  - APK de entrega: la URL HTTPS de la API publicada (obligatorio https://)
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# Login social (ver docs/guia-oauth.md)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GITHUB_CLIENT_ID=
EXPO_PUBLIC_FACEBOOK_APP_ID=
