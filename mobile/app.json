{
  "expo": {
    "name": "BurgosCorp ERP",
    "slug": "burgoscorp-erp",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.burgoscorp.erp"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#141416",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.burgoscorp.erp",
      "allowBackup": false,
      "permissions": []
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-web-browser",
      "expo-font"
    ],
    "scheme": "burgoscorp",
    "backgroundColor": "#141416",
    "primaryColor": "#C8102E"
  }
}
