{
  "expo": {
    "name": "BurgosCorp ERP",
    "slug": "burgoscorp-erp",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.burgoscorp.erp"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#141416",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.burgoscorp.erp",
      "allowBackup": false,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      [
        "expo-image-picker",
        {
          "cameraPermission": "BurgosCorp usa la cámara para sacar fotos del trabajo y escanear los códigos QR de piezas, máquinas y materiales.",
          "photosPermission": "BurgosCorp accede a tus fotos solo cuando elegís una para adjuntar.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "BurgosCorp usa la cámara para sacar fotos del trabajo y escanear los códigos QR de piezas, máquinas y materiales.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ]
    ],
    "scheme": "burgoscorp",
    "backgroundColor": "#141416",
    "primaryColor": "#C8102E",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "f71db92c-c9df-4f31-ba30-961c971e6e92"
      }
    },
    "owner": "silver1011"
  }
}
